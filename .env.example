# StudioSpace API - copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB (required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=studio-space

# Better Auth (required) - auth endpoints: <BETTER_AUTH_URL>/api/auth/*
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5000

# Frontend origin(s) - comma-separated; used for CORS and trustedOrigins
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# JWT access-token layer (required, HTTPOnly cookie auth for protected APIs)
JWT_ACCESS_SECRET=replace-with-a-dedicated-random-secret-at-least-32-chars
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:3000
JWT_ACCESS_TTL_SECONDS=900
# Optional cookie overrides (deployment-aware defaults are used if omitted)
# JWT_COOKIE_NAME=
# JWT_COOKIE_SECURE=
# JWT_COOKIE_SAMESITE=
# JWT_COOKIE_DOMAIN=
# CSRF_COOKIE_NAME=
# CSRF_HEADER_NAME=x-csrf-token

# Google OAuth (optional; enables Google sign-in when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

