# StudioSpace API - copy to .env and fill in real values. Never commit .env.
# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB=studio-space

# Server
PORT=5000

# Better Auth (hosted on THIS API server - endpoints live at <BETTER_AUTH_URL>/api/auth/*)
BETTER_AUTH_SECRET=generate-a-32-char-secret
BETTER_AUTH_URL=http://localhost:5000

# Frontend origin(s) - comma-separated allowed origins for CORS + trustedOrigins.
# Production example: https://your-studio-space.vercel.app
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth (Google Cloud Console > Credentials > OAuth 2.0 Client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
